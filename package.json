{
  "name": "webquake",
  "version": "1.0.0",
  "description": "Node version of WebQuake",
  "main": "index.js",
  "scripts": {
    "build": "rimraf ./dist && vue-tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.node.json",
    "build:justserver": "rimraf ./dist && tsc -p tsconfig.node.json",
    "build:sim": "cd wasm-sim && asc assembly/index.ts --target release -o ../static/wasm-sim/sim.wasm",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "vite serve",
    "serve:prod": "vite preview",
    "start:dev": "vite",
    "start:gameserver": "node ./dist/server/game",
    "debug:gameserver": "nodemon ./dist/server/game"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=16.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/vue-fontawesome": "^3.0.2",
    "@progress/jszip-esm": "^1.0.4",
    "@roamhq/wrtc": "^0.8.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/websocket": "^1.0.5",
    "@vitejs/plugin-vue": "^4.6.2",
    "base-64": "^1.0.0",
    "sass": "^1.56.1",
    "source-map-js": "^1.2.1",
    "stacktrace-parser": "^0.1.11",
    "ts-node": "^10.9.1",
    "vite": "^4.5.14",
    "vue": "^3.5.17",
    "vue-tippy": "^6.7.1",
    "vue-toastification": "^2.0.0-rc.5",
    "websocket": "^1.0.35"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/ramda": "^0.31.1",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/components": "^9.9.0",
    "@vueuse/core": "^9.9.0",
    "@webgpu/types": "^0.1.71",
    "assemblyscript": "^0.28.20",
    "autoprefixer": "^10.4.24",
    "axios": "^1.11.0",
    "chalk": "^2.4.2",
    "dotenv": "^6.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.4.0",
    "nodemon": "^1.18.10",
    "pinia": "^3.0.3",
    "postcss": "^8.5.6",
    "pug": "^3.0.3",
    "ramda": "^0.26.1",
    "rimraf": "^2.6.3",
    "tailwindcss": "^3.4.19",
    "ts-loader": "^9.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "vite-svg-loader": "^4.0.0",
    "vue-router": "^4.1.6",
    "vue-tsc": "^3.1.5"
  }
}
