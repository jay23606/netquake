# --- Supabase (lobby + WebRTC signaling) ---------------------------------
# Project Settings -> API. The anon key is public by design; RLS is what
# protects the data, so never put the service_role key in a VITE_ var.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- WebRTC ICE ----------------------------------------------------------
# Optional. Defaults to public Google STUN. Peers behind symmetric NAT need a
# TURN relay here as well, e.g.:
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=

# --- Legacy netquake.io services (unused once Supabase is wired) ---------
VITE_ALLOW_SERVER_DOWNLOADS=false
VITE_THUMBNAILS_PATH=https://servers.quakeone.com/mapthumbs
